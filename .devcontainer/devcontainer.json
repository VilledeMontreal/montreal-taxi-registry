{
	"name": "montreal-taxi-registry",
	"dockerComposeFile": [
		"./docker-compose.yml"
	],
	"service": "montreal-taxi-registry-dev-container",
	"workspaceFolder": "/workspace",
	"postStartCommand": "git config --global --add safe.directory /workspace",
	"features": {
		"ghcr.io/devcontainers/features/node:1": {
			"version": "24", // Version par défaut (API)
			"additionalVersions": "10" // Version installée en plus (UI)
		}
	},
	"customizations": {
		// Configure properties specific to VS Code.
		"vscode": {
			// Add the IDs of extensions you want installed when the container is created.
			"extensions": [
				"esbenp.prettier-vscode",
				"dbaeumer.vscode-eslint",
				"streetsidesoftware.code-spell-checker",
				"arjun.swagger-viewer",
				"searking.preview-vscode",
				"redhat.vscode-yaml",
				"donjayamanne.githistory",
				"waderyan.gitblame"
			],
			"settings": {
				// Pour que les devs n'aient rien à configurer
				"terminal.integrated.profiles.linux": {
					"UI Taxi Registry (Node 10)": {
						"path": "/bin/bash",
						"args": [
							"-c",
							"source /usr/local/share/nvm/nvm.sh && nvm use 10 && exec /bin/bash"
						],
						"icon": "history", 
        				"color": "terminal.ansiYellow" 
					}
				}
			}
		}
	}
}